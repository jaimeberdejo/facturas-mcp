# Configuración de facturas-mcp: cópiala a ~/.config/facturas-mcp/.env (recomendado, fuera del repositorio)
# o a .env en la raíz del repositorio (excluido en .gitignore). No subas nunca el fichero real.
#
#   mkdir -p ~/.config/facturas-mcp && cp .env.example ~/.config/facturas-mcp/.env && chmod 600 ~/.config/facturas-mcp/.env

# --- Entorno -----------------------------------------------------------------
# sandbox (por defecto) o production. En production se emiten facturas REALES registradas en la AEAT.
# Déjalo comentado hasta haberlo probado todo en el sandbox.
# FACTURAS_ENV=production

# mock (por defecto: nada sale de tu equipo) o beel.
FACTURAS_PROVIDER=mock

# --- Serie -------------------------------------------------------------------
# Primer número que emitirá este servidor (formato AAAANNN). Los números solo avanzan.
# Por defecto, AAAA001 del año en curso (p. ej. 2026001). Si continúas una serie que ya tiene
# facturas, pon el siguiente número; por ejemplo, si ya emitiste la 2026001:
# FACTURAS_NUMERO_INICIAL=2026002
# % de IRPF en las líneas de servicio (los bienes nunca llevan IRPF). 7 = tipo reducido por inicio de actividad.
FACTURAS_IRPF_POR_DEFECTO=7

# --- Emisor (tú) -------------------------------------------------------------
# Se muestra en los resúmenes. BeeL toma los datos del emisor del perfil de tu empresa en BeeL.
FACTURAS_EMISOR_NOMBRE=Nombre Apellido Apellido
FACTURAS_EMISOR_NIF=00000000T
FACTURAS_EMISOR_DIRECCION=Calle Ejemplo 1, 28000 Ciudad (Provincia)
# Figura en la factura como forma de pago por transferencia.
FACTURAS_EMISOR_IBAN=ES0000000000000000000000
FACTURAS_EMISOR_EMAIL=tu@email.example

# --- BeeL (solo con FACTURAS_PROVIDER=beel) ----------------------------------
# La clave de sandbox empieza por beel_sk_test_; en sandbox, el servidor rechaza cualquier otra.
BEEL_API_KEY=beel_sk_test_REPLACE_ME
# UUID de tu empresa en BeeL (no tu NIF). Ver README → "Sandbox de BeeL".
BEEL_COMPANY_ID=00000000-0000-0000-0000-000000000000
# Opcional: UUID de la serie STANDARD que se usará. Si no se indica, se usa la serie por defecto de la empresa.
# BEEL_SERIES_ID=00000000-0000-0000-0000-000000000000

# --- Rutas (opcional) --------------------------------------------------------
# Por defecto: <repo>/data (excluido en .gitignore), con una subcarpeta por entorno.
# FACTURAS_DATA_DIR=/ruta/absoluta/a/data
# FACTURAS_PDF_DIR=/ruta/absoluta/a/pdfs
