# facturas-mcp configuration — copy to ~/.config/facturas-mcp/.env (recommended, outside the repo)
# or to .env in the repo root (gitignored). Never commit the real file.
#
#   mkdir -p ~/.config/facturas-mcp && cp .env.example ~/.config/facturas-mcp/.env && chmod 600 ~/.config/facturas-mcp/.env

# --- Environment -----------------------------------------------------------
# sandbox (default) or production. Production issues REAL invoices registered with the AEAT.
# Leave it commented out until you have tested everything in the sandbox.
# FACTURAS_ENV=production

# mock (default: nothing leaves your machine) or beel.
FACTURAS_PROVIDER=mock

# --- Series ----------------------------------------------------------------
# First number this server will issue (format YYYYNNN). Numbers only move forward.
FACTURAS_NUMERO_INICIAL=2026003
# IRPF % applied to service lines (goods never carry IRPF). 7 = new-activity reduced rate.
FACTURAS_IRPF_POR_DEFECTO=7

# --- Issuer (you) ----------------------------------------------------------
# Shown in summaries. BeeL takes the issuer data from your BeeL company profile.
FACTURAS_EMISOR_NOMBRE=Nombre Apellido Apellido
FACTURAS_EMISOR_NIF=00000000T
FACTURAS_EMISOR_DIRECCION=Calle Ejemplo 1, 28000 Ciudad (Provincia)
# Printed as the bank-transfer payment method on the invoice.
FACTURAS_EMISOR_IBAN=ES0000000000000000000000
FACTURAS_EMISOR_EMAIL=tu@email.example

# --- BeeL (only with FACTURAS_PROVIDER=beel) ---------------------------------
# Sandbox key starts with beel_sk_test_ ; the server refuses any other key in sandbox.
BEEL_API_KEY=beel_sk_test_REPLACE_ME
# UUID of your company in BeeL (not your NIF). See README → "BeeL sandbox".
BEEL_COMPANY_ID=00000000-0000-0000-0000-000000000000
# Optional: UUID of the STANDARD series to use. Omit to use the company's default series.
# BEEL_SERIES_ID=00000000-0000-0000-0000-000000000000

# --- Paths (optional) ------------------------------------------------------
# Defaults: <repo>/data (gitignored), one subfolder per environment.
# FACTURAS_DATA_DIR=/absolute/path/to/data
# FACTURAS_PDF_DIR=/absolute/path/to/pdfs
